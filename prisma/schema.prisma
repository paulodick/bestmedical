// ===== Prisma schema — Best Medical (Fase 1) =====
// PostgreSQL. Valores monetários em centavos (Int). Datas em DateTime (@db.Date).
//
// Quatro schemas Postgres no mesmo banco — tabelas fisicamente separadas,
// sem overlap, sem custo de infraestrutura extra (mesmo banco
// bestmedical-db do Render):
// - "public": dados da empresa Best Medical (orçamentos, propostas, CRM,
//   despesas/recebíveis da empresa).
// - "pessoal": Controle Financeiro Pessoal — acesso por senha compartilhada
//   (não pelo login de usuário da Best), ver módulo financeiro-pessoal-auth.
// - "padu": Controle Financeiro da Padu Studios — empresa separada, sem
//   nenhuma relação com os dados da Best.
// - "reservado": sub-área da senha Pessoal, liberada apenas por uma segunda
//   senha (não a mesma usada para "pessoal"). Ver financeiro-pessoal-auth —
//   por design, nada no comportamento do sistema deve indicar a existência
//   desse schema a quem só conhece a senha comum.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "pessoal", "padu", "reservado"]
}

enum Perfil {
  admin
  operador
  visualizador

  @@schema("public")
}

enum Prioridade {
  preto
  vermelho
  amarelo
  verde

  @@schema("public")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  // Login por usuário (nome+sobrenome juntos, minúsculo, sem espaços). Único.
  usuario   String   @unique
  email     String   @unique
  senhaHash String   @map("senha_hash")
  perfil    Perfil   @default(operador)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orcamentos Orcamento[]
  propostas  Proposta[]
  followUps  FollowUp[]

  @@map("usuarios")
  @@schema("public")
}

model Cliente {
  id          String   @id @default(uuid())
  cnpj        String?  @unique
  nome        String
  cep         String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?  @db.Char(2)
  pais        String   @default("Brasil")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contatos   Contato[]
  orcamentos Orcamento[]
  propostas  Proposta[]

  @@map("clientes")
  @@schema("public")
}

model Contato {
  id        String   @id @default(uuid())
  clienteId String   @map("cliente_id")
  nome      String
  setor     String?
  telefone  String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  orcamentos Orcamento[]
  propostas  Proposta[]

  @@map("contatos")
  @@schema("public")
}

// ===== CRM — agenda de contatos independente =====
// Lista de contatos importada do celular (vCard/CSV) ou cadastrada à mão.
// Não tem relação com Cliente/Orçamento: é uma agenda comercial própria.
model CrmContato {
  id              String   @id @default(uuid())
  nome            String
  empresa         String?
  telefone        String?
  telefonePessoal String?  @map("telefone_pessoal")
  email           String?
  // Cidade/estado do contato. Preenchidos na importação cruzando o DDD do
  // telefone e/ou a cidade/UF citada no nome. Cidade preenche o estado
  // automaticamente; cidade ambígua (várias UFs) deixa estado em branco.
  cidade          String?
  estado          String?  @db.VarChar(2)
  // Relacionamento: 1 (sem relacionamento) a 5 (excelente). Default 1.
  relacionamento  Int      @default(1)
  // Pessoal: marca contatos pessoais (não profissionais). Continua no banco,
  // mas pode ser ocultado por filtro na tela do CRM.
  pessoal         Boolean  @default(false)
  // Atendido: marca contatos já atendidos (já tiveram orçamento/proposta/
  // venda com a Best Medical) — organiza a prospecção no CRM.
  atendido        Boolean  @default(false)
  // Tem WhatsApp: marcador filtrável, preenchido manualmente ou por
  // verificação cruzada com a lista de contatos do WhatsApp Web.
  temWhatsapp     Boolean  @default(false) @map("tem_whatsapp")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("crm_contatos")
  @@schema("public")
}

model Orcamento {
  id     String   @id @default(uuid())
  numero String   @unique
  data   DateTime @db.Date

  clienteId String  @map("cliente_id")
  contatoId String? @map("contato_id")
  criadoPor String? @map("criado_por")

  // Snapshot (preenchido na emissão) — preserva histórico
  clienteNomeSnap String? @map("cliente_nome_snap")
  clienteCnpjSnap String? @map("cliente_cnpj_snap")
  solicitanteSnap String? @map("solicitante_snap")
  setorSnap       String? @map("setor_snap")
  telefoneSnap    String? @map("telefone_snap")
  emailSnap       String? @map("email_snap")

  // Dados técnicos
  modalidade      String?
  marca           String?
  marcaOutras     String? @map("marca_outras")
  modelo          String?
  numeroSerie     String? @map("numero_serie")
  descricaoVisita String? @map("descricao_visita")

  // Resumo financeiro
  descontoPercent  Float @default(0) @map("desconto_percent")
  numParcelas      Int   @default(1) @map("num_parcelas")
  subtotalCentavos Int   @default(0) @map("subtotal_centavos")
  descontoCentavos Int   @default(0) @map("desconto_centavos")
  totalCentavos    Int   @default(0) @map("total_centavos")
  // Total manual (override): quando preenchido, prevalece sobre o total
  // calculado pelos itens/desconto. Usado para correção rápida no Controle.
  totalManualCentavos Int? @map("total_manual_centavos")

  // Finalização
  observacoes String?
  textoFinal  String? @map("texto_final")

  // Status (espelha a página de Controle)
  statusEnviado            Boolean   @default(false) @map("status_enviado")
  statusAprovado           Boolean   @default(false) @map("status_aprovado")
  statusRealizado          Boolean   @default(false) @map("status_realizado")
  statusAguardandoPeca     Boolean   @default(false) @map("status_aguardando_peca")
  statusOrdemServico       Boolean   @default(false) @map("status_ordem_servico")
  statusPagamentoRealizado Boolean   @default(false) @map("status_pagamento_realizado")
  statusReprovado          Boolean   @default(false) @map("status_reprovado")
  // Status financeiros (página Controle Financeiro)
  statusPago               Boolean   @default(false) @map("status_pago")
  statusAtrasado           Boolean   @default(false) @map("status_atrasado")
  statusCancelado          Boolean   @default(false) @map("status_cancelado")
  // Data prevista do recebimento (usada p/ acionar Atrasado automaticamente)
  dataPagamento            DateTime? @map("data_pagamento") @db.Date
  // Condição de pagamento (texto livre, ex.: "Antecipado", "30 dias") — usada
  // quando ainda não há uma data definida. Mutuamente exclusivo com
  // dataPagamento na UI (Controle).
  condicaoPagamento        String?   @map("condicao_pagamento")
  enviadoEm                DateTime? @map("enviado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  contato      Contato?        @relation(fields: [contatoId], references: [id])
  criador      Usuario?        @relation(fields: [criadoPor], references: [id])
  itens        ItemOrcamento[]
  parcelas     Parcela[]
  ordemServico OrdemServico?
  followUps    FollowUp[]

  @@index([data])
  @@index([clienteId])
  @@map("orcamentos")
  @@schema("public")
}

model ItemOrcamento {
  id                String @id @default(uuid())
  orcamentoId       String @map("orcamento_id")
  ordem             Int    @default(0)
  codigo            String @default("")
  descricao         String @default("")
  quantidade        Int    @default(1)
  valorItemCentavos Int    @default(0) @map("valor_item_centavos")

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
  @@map("itens_orcamento")
  @@schema("public")
}

model Parcela {
  id             String    @id @default(uuid())
  orcamentoId    String    @map("orcamento_id")
  numero         Int
  dataVencimento DateTime? @map("data_vencimento") @db.Date
  // Condição de vencimento em texto livre (ex.: "Antecipado", "30 dias") —
  // alternativa à dataVencimento no mesmo campo da UI (Data Pagamento).
  condicaoVencimento String? @map("condicao_vencimento")
  valorCentavos  Int       @default(0) @map("valor_centavos")
  pago           Boolean   @default(false)
  pagoEm         DateTime? @map("pago_em") @db.Date

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
  @@map("parcelas")
  @@schema("public")
}

model OrdemServico {
  id          String   @id @default(uuid())
  numero      String   @unique // OS-2026-0001
  orcamentoId String   @unique @map("orcamento_id") // 1 OS por orçamento
  data        DateTime @db.Date

  // Snapshot de cliente/solicitante/equipamento (copiado do orçamento na criação)
  clienteNomeSnap String? @map("cliente_nome_snap")
  clienteCnpjSnap String? @map("cliente_cnpj_snap")
  // Endereço copiado do cadastro do cliente no momento da criação
  cep             String?
  endereco        String?
  enderecoNumero  String? @map("endereco_numero")
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  pais            String? @default("Brasil")
  solicitanteSnap String? @map("solicitante_snap")
  setorSnap       String? @map("setor_snap")
  telefoneSnap    String? @map("telefone_snap")
  emailSnap       String? @map("email_snap")

  // Equipamento
  modalidade      String?
  marca           String?
  marcaOutras     String? @map("marca_outras")
  modelo          String?
  numeroSerie     String? @map("numero_serie")
  descricaoVisita String? @map("descricao_visita")

  // Campos próprios da OS
  descricaoServico String? @map("descricao_servico") // caixa de texto "descrição do serviço"
  observacoes      String?

  // Assinaturas (data URL base64 PNG do canvas — pode ficar grande, use @db.Text)
  assinaturaCliente String? @map("assinatura_cliente") @db.Text
  assinaturaTecnico String? @map("assinatura_tecnico") @db.Text

  statusEnviado Boolean   @default(false) @map("status_enviado")
  enviadoEm     DateTime? @map("enviado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  itens        ItemOS[]
  fotos        FotoOS[]
  atendimentos AtendimentoOS[]

  @@map("ordens_servico")
  @@schema("public")
}

// Conjunto de atendimento da OS: data + técnico + descrição. Substitui o
// antigo campo único "descricaoServico" (mantido na tabela por segurança/
// histórico, mas não é mais editado pela tela). Quantidade ilimitada.
model AtendimentoOS {
  id        String   @id @default(uuid())
  ordemId   String   @map("ordem_id")
  ordem     Int      @default(0)
  data      DateTime @db.Date
  tecnico   String   @default("")
  descricao String   @default("") @db.Text

  os OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  @@index([ordemId])
  @@map("atendimentos_os")
  @@schema("public")
}

model ItemOS {
  id         String  @id @default(uuid())
  ordemId    String  @map("ordem_id")
  ordem      Int     @default(0) // posição
  codigo     String  @default("")
  descricao  String  @default("") // "item"
  quantidade Int     @default(1)
  realizado  Boolean @default(false) // checkbox "trabalho realizado"
  detalhes   String  @default("") // coluna "Detalhes" (campo preenchível)

  os OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  @@index([ordemId])
  @@map("itens_os")
  @@schema("public")
}

model FotoOS {
  id      String @id @default(uuid())
  ordemId String @map("ordem_id")
  ordem   Int    @default(0)
  // Imagem em data URL base64 (jpeg/png). Use @db.Text.
  dataUrl String @map("data_url") @db.Text
  legenda String @default("")

  os OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  @@index([ordemId])
  @@map("fotos_os")
  @@schema("public")
}

// ===== Proposta de Contrato =====
// Espelha o Orcamento: snapshots de cliente/solicitante, resumo financeiro em
// centavos e back-relations opcionais para Cliente/Contato/Usuario. Os
// equipamentos cobertos ficam em ItemPropostaEquip (1 linha = 1 equipamento,
// com o "Valor do Contrato" mensal próprio).
model Proposta {
  id     String   @id @default(uuid())
  numero String   @unique // PC-2026-0001
  data   DateTime @db.Date

  clienteId String  @map("cliente_id")
  contatoId String? @map("contato_id")
  criadoPor String? @map("criado_por")

  // Snapshot (preenchido na emissão) — preserva histórico
  clienteNomeSnap String? @map("cliente_nome_snap")
  clienteCnpjSnap String? @map("cliente_cnpj_snap")
  solicitanteSnap String? @map("solicitante_snap")
  setorSnap       String? @map("setor_snap")
  telefoneSnap    String? @map("telefone_snap")
  emailSnap       String? @map("email_snap")

  // Modalidade do contrato
  tipoContrato String @map("tipo_contrato") // "Suporte Remoto" | "Mão de Obra - Regular" | "Mão de Obra - Especial"

  // Condições do contrato (texto editável) + snapshot do texto padrão vigente
  // na criação (usado como base estável para o diff de customizações).
  condicoesContrato   String @default("") @map("condicoes_contrato") @db.Text
  condicoesPadraoSnap String @default("") @map("condicoes_padrao_snap") @db.Text
  // Observações internas: recebe automaticamente o bloco de customizações
  // (entre marcadores) e preserva anotações manuais. Não aparece no PDF.
  observacoesInternas String @default("") @map("observacoes_internas") @db.Text

  // Texto final (rodapé do PDF)
  textoFinal String? @map("texto_final") @db.Text

  // Resumo financeiro (mensal)
  descontoPercent  Float @default(0) @map("desconto_percent")
  subtotalCentavos Int   @default(0) @map("subtotal_centavos")
  descontoCentavos Int   @default(0) @map("desconto_centavos")
  totalCentavos    Int   @default(0) @map("total_centavos")
  // Total manual (override) mensal: prevalece sobre o total calculado.
  totalManualCentavos Int? @map("total_manual_centavos")

  // Status / envio (mesmos status de controle do orçamento)
  statusEnviado            Boolean   @default(false) @map("status_enviado")
  statusAprovado           Boolean   @default(false) @map("status_aprovado")
  statusRealizado          Boolean   @default(false) @map("status_realizado")
  statusAguardandoPeca     Boolean   @default(false) @map("status_aguardando_peca")
  statusOrdemServico       Boolean   @default(false) @map("status_ordem_servico")
  statusPagamentoRealizado Boolean   @default(false) @map("status_pagamento_realizado")
  // Status específicos de Proposta de Contrato (PC)
  statusAssinado           Boolean   @default(false) @map("status_assinado")
  statusVigente            Boolean   @default(false) @map("status_vigente")
  statusReprovado          Boolean   @default(false) @map("status_reprovado")
  // Status financeiros (página Controle Financeiro)
  statusPago               Boolean   @default(false) @map("status_pago")
  statusAtrasado           Boolean   @default(false) @map("status_atrasado")
  statusCancelado          Boolean   @default(false) @map("status_cancelado")
  // Data prevista do recebimento (usada p/ acionar Atrasado automaticamente)
  dataPagamento            DateTime? @map("data_pagamento") @db.Date
  // Condição de pagamento (texto livre, ex.: "Antecipado", "30 dias") — usada
  // quando ainda não há uma data definida. Mutuamente exclusivo com
  // dataPagamento na UI (Recebíveis).
  condicaoPagamento        String?   @map("condicao_pagamento")
  // Data de início da vigência do contrato. Enquanto vazia, o contrato NÃO
  // entra no Controle Financeiro (pagamento mensal ainda não ativado).
  inicioContrato           DateTime? @map("inicio_contrato") @db.Date
  // Período de vigência do contrato, em meses (padrão 12). Determina quantas
  // parcelas mensais (ParcelaContrato) são geradas em Recebíveis, uma por
  // mês a partir do dia do mês de inicioContrato.
  vigenciaMeses            Int       @default(12) @map("vigencia_meses")
  enviadoEm                DateTime? @map("enviado_em")

  // Contrato assinado (PDF) carregado pelo usuário, armazenado em base64.
  contratoAssinadoArquivo String?   @map("contrato_assinado_arquivo") @db.Text
  contratoAssinadoNome    String?   @map("contrato_assinado_nome")
  contratoAssinadoEm      DateTime? @map("contrato_assinado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente      Cliente             @relation(fields: [clienteId], references: [id])
  contato      Contato?            @relation(fields: [contatoId], references: [id])
  criador      Usuario?            @relation(fields: [criadoPor], references: [id])
  equipamentos     ItemPropostaEquip[]
  contrato         Contrato?
  followUps        FollowUp[]
  parcelasContrato ParcelaContrato[]

  @@index([data])
  @@index([clienteId])
  @@map("propostas")
  @@schema("public")
}

// Parcela mensal do pagamento recorrente de um contrato (Proposta). Gerada
// automaticamente a partir de inicioContrato + vigenciaMeses; cada parcela
// pode ser marcada como paga individualmente (o recebimento de um mês não
// depende dos demais). Mesmo formato de Parcela (Orcamento), mas em tabela
// própria pois o vínculo é com Proposta.
model ParcelaContrato {
  id             String    @id @default(uuid())
  propostaId     String    @map("proposta_id")
  numero         Int
  dataVencimento DateTime? @map("data_vencimento") @db.Date
  condicaoVencimento String? @map("condicao_vencimento")
  valorCentavos  Int       @default(0) @map("valor_centavos")
  pago           Boolean   @default(false)
  pagoEm         DateTime? @map("pago_em") @db.Date

  proposta Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@index([propostaId])
  @@map("parcelas_contrato")
  @@schema("public")
}

// Registro de follow-up (acompanhamento comercial). Vinculado a um
// orçamento OU a uma proposta. Guarda quem escreveu e quando.
model FollowUp {
  id          String   @id @default(uuid())
  orcamentoId String?  @map("orcamento_id")
  propostaId  String?  @map("proposta_id")
  autorId     String?  @map("autor_id")
  autorNome   String   @map("autor_nome")
  texto       String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  orcamento Orcamento? @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  proposta  Proposta?  @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  autor     Usuario?   @relation(fields: [autorId], references: [id])

  @@index([orcamentoId])
  @@index([propostaId])
  @@map("follow_ups")
  @@schema("public")
}

// ===== Contrato =====
// Documento de contrato gerado a partir de uma Proposta aprovada (1 contrato
// por proposta). Espelha o fluxo da Ordem de Serviço (gerada do orçamento):
// guarda um snapshot do corpo padrão gerado a partir do template e o corpo
// efetivamente customizado pelo usuário. As customizações (diff linha a linha
// do corpo customizado x padrão) são replicadas nas Observações Internas da
// PROPOSTA de origem, no mesmo formato de marcadores usado no resto do sistema.
model Contrato {
  id         String   @id @default(uuid())
  numero     String   @unique // CT-2026-0001 (derivado do número da proposta)
  propostaId String   @unique @map("proposta_id") // 1 contrato por proposta
  data       DateTime @db.Date

  // Corpo do contrato (cláusulas) em texto, uma cláusula/linha por parágrafo.
  // conteudoPadraoSnap = versão gerada do template na criação (base do diff).
  // conteudoCustomizado = versão editada pelo usuário (renderizada no PDF).
  conteudoPadraoSnap  String @default("") @map("conteudo_padrao_snap") @db.Text
  conteudoCustomizado String @default("") @map("conteudo_customizado") @db.Text

  dataGeracao DateTime @default(now()) @map("data_geracao")

  statusEnviado Boolean   @default(false) @map("status_enviado")
  enviadoEm     DateTime? @map("enviado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proposta Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@map("contratos")
  @@schema("public")
}

model ItemPropostaEquip {
  id            String @id @default(uuid())
  propostaId    String @map("proposta_id")
  ordem         Int    @default(0)
  modalidade    String @default("")
  marca         String @default("")
  marcaOutras   String @default("") @map("marca_outras")
  modelo        String @default("")
  numeroSerie   String @default("") @map("numero_serie")
  // "Valor do Contrato" (mensal) da linha, em centavos
  valorCentavos Int    @default(0) @map("valor_centavos")

  proposta Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@index([propostaId])
  @@map("itens_proposta_equip")
  @@schema("public")
}

// ===================== Despesa (Controle Financeiro) =====================
// Registro de saídas financeiras (contas a pagar / pagas). Espelha a aba
// "Despesas" da planilha de controle. Valor armazenado em centavos (Int) e
// exposto em reais pela API, seguindo a convenção dos orçamentos.
model Despesa {
  id                String      @id @default(uuid())
  // Data de competência/vencimento (yyyy-mm-dd no fuso local, guardada em UTC).
  data              DateTime
  fornecedor        String
  // Categoria livre (ex.: Peças, Impostos, Salários, Transporte...).
  categoria         String?
  descricao         String?
  valorCentavos     Int         @map("valor_centavos")
  // Total já pago (cache — soma de "baixas"; permite pagamento parcial).
  // Saldo devedor = valor - valorPago.
  valorPagoCentavos Int         @default(0) @map("valor_pago_centavos")
  // Situação de pagamento.
  pago              Boolean     @default(false)
  // Data em que foi efetivamente paga (opcional).
  dataPagamento     DateTime?   @map("data_pagamento")
  // Projeto/centro de custo opcional (ex.: nome do hospital/contrato).
  projeto           String?
  observacoes       String?
  // Prioridade visual (cor). Sem valor = sem prioridade definida.
  prioridade        Prioridade?
  // Boleto anexado (mesmo padrão do contrato assinado: base64 em texto).
  boletoArquivo     String?     @db.Text @map("boleto_arquivo")
  boletoNome        String?     @map("boleto_nome")
  boletoEm          DateTime?   @map("boleto_em")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  baixas BaixaDespesa[]

  @@index([data])
  @@index([pago])
  @@index([prioridade])
  @@map("despesas")
  @@schema("public")
}

// Cada pagamento (total ou parcial) registrado contra uma Despesa. Permite
// baixar um valor de cada vez (ex.: R$2.000 de R$10.000, depois o restante)
// mantendo data e forma de pagamento de cada baixa — histórico de verdade,
// não só um número acumulado.
model BaixaDespesa {
  id             String   @id @default(uuid())
  despesaId      String   @map("despesa_id")
  data           DateTime
  valorCentavos  Int      @map("valor_centavos")
  formaPagamento String   @map("forma_pagamento") // Pix, Boleto, Transferência, Cartão...
  observacao     String?
  createdAt      DateTime @default(now()) @map("created_at")

  despesa Despesa @relation(fields: [despesaId], references: [id], onDelete: Cascade)

  @@index([despesaId])
  @@map("baixas_despesa")
  @@schema("public")
}

// ===== Recebível avulso =====
// Recebimento manual (avulso), sem vínculo com orçamento ou proposta.
// Aparece no Controle Financeiro (Recebíveis) junto com os automáticos.
model Recebivel {
  id            String    @id @default(uuid())
  // Data de competência/emissão (yyyy-mm-dd no fuso local, guardada em UTC).
  data          DateTime
  // Identificação livre do pagador.
  empresa       String
  cnpj          String?
  descricao     String?
  valorCentavos Int       @map("valor_centavos")
  // Total já recebido (cache — soma de "baixas"; permite recebimento parcial).
  valorPagoCentavos Int   @default(0) @map("valor_pago_centavos")
  // Situação de recebimento.
  pago          Boolean   @default(false)
  dataPagamento DateTime? @map("data_pagamento")
  // Condição de pagamento (texto livre, ex.: "Antecipado", "30 dias") —
  // mutuamente exclusiva com dataPagamento na UI (Recebíveis).
  condicaoPagamento String? @map("condicao_pagamento")
  observacoes   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  baixas BaixaRecebivel[]

  @@index([data])
  @@index([pago])
  @@map("recebiveis")
  @@schema("public")
}

// Cada recebimento (total ou parcial) registrado contra um Recebível avulso.
model BaixaRecebivel {
  id             String   @id @default(uuid())
  recebivelId    String   @map("recebivel_id")
  data           DateTime
  valorCentavos  Int      @map("valor_centavos")
  formaPagamento String   @map("forma_pagamento")
  observacao     String?
  createdAt      DateTime @default(now()) @map("created_at")

  recebivel Recebivel @relation(fields: [recebivelId], references: [id], onDelete: Cascade)

  @@index([recebivelId])
  @@map("baixas_recebivel")
  @@schema("public")
}

// ===== Lançamento financeiro pessoal (legado) =====
// Substituído por DespesaPessoal/RecebivelPessoal (schema "pessoal"). Mantido
// só como rede de segurança até a migração de dados ser confirmada em
// produção — não é mais escrito pelas telas novas. Remover numa migration
// própria depois da validação.
model LancamentoPessoal {
  id            String    @id @default(uuid())
  data          DateTime
  // 'receita' (entrada) ou 'despesa' (saída).
  tipo          String
  // Pessoa a quem o lançamento pertence (ex.: Paulo, Luisa).
  pessoa        String
  categoria     String?
  descricao     String?
  valorCentavos Int       @map("valor_centavos")
  // Situação: pago (despesa) ou recebido (receita).
  pago          Boolean   @default(false)
  dataPagamento DateTime? @map("data_pagamento")
  observacoes   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([data])
  @@index([tipo])
  @@index([pessoa])
  @@map("lancamentos_pessoais")
  @@schema("public")
}

// ===================== Controle Financeiro Pessoal =====================
// Schema Postgres próprio ("pessoal") — fisicamente separado das tabelas da
// empresa, exclusivo do admin master (paulodick). Mesmo formato de
// Despesa/Recebivel (baixa parcial com histórico própio), só que por pessoa.

// Configuração (linha única, id fixo "config") da autenticação por senha da
// área Pessoal — guarda só os HASHES (bcrypt) das duas senhas, nunca a senha
// em texto puro. senhaSecretaHash começa nulo: só é preenchido quando o
// próprio dono cadastra a segunda senha de dentro da área Pessoal.
// Configuração (linha única) de TODA a autenticação do app Financeiro —
// os 3 níveis em cascata (entrada/app → pessoal → secreta) e o PIN único de
// recuperação. Só hashes, nunca senha/PIN em texto puro.
model PessoalAuthConfig {
  id                 String    @id @default("config")
  // Nível 1 — abre o app (usuário fixo "paulodick"), dá acesso ao
  // Financeiro Best (espelhado).
  senhaEntradaHash   String?   @map("senha_entrada_hash")
  // Nível 2 — Financeiro Pessoal.
  senhaComumHash     String?   @map("senha_comum_hash")
  // Nível 3 — Financeiro Top Secret.
  senhaSecretaHash   String?   @map("senha_secreta_hash")
  // PIN único de 6 dígitos — recupera qualquer um dos 3 níveis.
  pinRecuperacaoHash String?   @map("pin_recuperacao_hash")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("pessoal_auth_config")
  @@schema("pessoal")
}

